# =============================================================================
# Hosted multi-user configuration
# Required for the deployed Next.js app (Vercel), and for local dev against
# the same Supabase project.
# =============================================================================

# Supabase project config. The NEXT_PUBLIC_ versions are safe to expose to
# the browser (anon key only) and are what the Supabase Auth browser/server
# clients use. SUPABASE_URL/SUPABASE_ANON_KEY are read as a fallback for
# compatibility with existing deployments -- prefer the NEXT_PUBLIC_ names.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only. Never exposed to the browser. Used for LiveMopay connection
# persistence, sync ingestion writes, and the backfill script.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# LiveMopay web API. Application-level config, not per-user identity -- no
# email/password/account id belongs here anymore.
NEWINMETER_FIREBASE_API_KEY=your-firebase-web-api-key
NEWINMETER_WEB_BASE_URL=https://app.propertywallet.co.za
NEWINMETER_WEB_PORTAL_ORIGIN=https://app.livewalletportal.co.za
NEWINMETER_WEB_APP_FLAVOR=livemopay

# Base64-encoded 32-byte AES-256-GCM key used to encrypt LiveMopay refresh
# tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEWINMETER_TOKEN_ENCRYPTION_KEY=

# Assistant. Optional -- the dashboard assistant is disabled without it.
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4.1-mini

# Upstash Redis. Required -- backs the durable per-user rate limits (API
# routes throw on first request without these). Create a free database at
# https://console.upstash.com, or via the Vercel Marketplace "Upstash"
# storage integration (which names these KV_REST_API_URL/TOKEN instead --
# either naming works). Copy the values from its Quickstart/.env.local tab.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push (installed-PWA background badge + stale-data notification). Optional
# -- the in-app badge works without it; these enable updating the badge and
# sending one notification while the app is closed. Generate a keypair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is exposed to the browser (client subscribes with it); the
# private key is server-only. VAPID_SUBJECT defaults to a mailto: address.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@newinmeter.app

# Shared secret guarding the /api/cron/stale-check endpoint. Vercel Cron sends
# it automatically as `Authorization: Bearer <CRON_SECRET>` when set as a
# project env var. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# =============================================================================
# One-time legacy-owner backfill (scripts/backfill-legacy-owner.ts)
# Not needed for normal running -- only set these when running the backfill.
# See MULTI_USER_SETUP.md.
# =============================================================================

# LEGACY_OWNER_USER_ID=uuid-of-the-supabase-auth-user-that-owns-existing-data
# LEGACY_OWNER_LIVEMOPAY_EMAIL=you@example.com

# =============================================================================
# Demo/recruiter account (scripts/seed-demo-account.ts, /api/demo-login)
# Optional. Only needed if you want the one-click recruiter demo URL
# (/login?demo=<NEWINMETER_DEMO_ACCESS_TOKEN>) -- without these two set, the
# demo button never renders and the endpoint always denies. Never contacts
# LiveMopay; see the README "Demo account" section. Do not commit real values
# for these -- NEWINMETER_DEMO_ACCESS_TOKEN in particular is a bearer secret:
# anyone who has it can sign in as the demo account.
# =============================================================================

# NEWINMETER_DEMO_EMAIL=demo@newinmeter.app

# Long random string gating /login?demo=<token> and /api/demo-login. Generate
# with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# NEWINMETER_DEMO_ACCESS_TOKEN=

# =============================================================================
# Legacy local-only setup (Python CLI: newinmeter_web.py / refresh_and_sync.py
# / capture_livemopay.py). Not used by the hosted multi-user app. Keep these
# only if you still run the personal local refresh path.
# =============================================================================

# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key

# NEWINMETER_WEB_EMAIL=you@example.com
# NEWINMETER_WEB_PASSWORD=your-livewallet-password
# NEWINMETER_ACCOUNT_ID=your-account-id
# NEWINMETER_COMPANY_ID=your-company-id
# NEWINMETER_PROPERTY_ID=your-property-id
# NEWINMETER_WEB_SESSION_PATH=.secrets/livemopay_auth.json
# NEWINMETER_WEB_AUTH_HEADER=Authorization
# NEWINMETER_WEB_AUTH_SCHEME=Bearer
# NEWINMETER_WEB_REFRESH_BUFFER_SECONDS=300
# NEWINMETER_WEB_START_DATE=2026-01-01
# NEWINMETER_TIMEZONE=Africa/Johannesburg

# Optional: only needed if adb is not on PATH and the default Android Studio path is not correct.
# ADB_PATH=/path/to/adb
# ADB_SERIAL=emulator-5554

# Optional: emulator refresh settings used by `npm run refresh:emulator`.
# NEWINMETER_AVD_NAME=Your_AVD_Name
# NEWINMETER_PACKAGE_NAME=livemopay.co.za
# NEWINMETER_ACTIVITY_NAME=com.example.property_wallet.MainActivity
# EMULATOR_CMD=/path/to/emulator

# Optional: capture tuning and output locations.
# NEWINMETER_CSV_PATH=livemopay_energy.csv
# NEWINMETER_DUMPS_DIR=livemopay_dumps
# NEWINMETER_CAPTURE_LOG=livemopay_capture.log
# NEWINMETER_MAX_ITERATIONS=500
# NEWINMETER_MAX_STAGNANT_ROUNDS=4
# NEWINMETER_SCREEN_WAIT_ATTEMPTS=15
# NEWINMETER_SCREEN_WAIT_SECONDS=2.0
