(footprint "LDR_THT_D5.0mm_P5.08mm"
  (version 20221018)
  (generator pcbnew)
  (layer "F.Cu")
  (descr "Generic 5mm CdS photoresistor (e.g. GL5528-class), THT, 2-pin, non-polarized. Body dia ~5mm (mfr datasheets: 4.9-5.4mm across common GL55xx variants). Lead pitch is NOT standardized across manufacturers (typically 3-5mm as supplied, leads field-formable) -- 5.08mm (0.2in) chosen to match common bent-lead THT sensor spacing seen in hobbyist kits; verify against your specific stock part before populating, and re-form leads if needed.")
  (tags "LDR photoresistor CdS")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -4.5) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "LDR_THT_D5.0mm_P5.08mm" (at 0 4.5) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_circle (center 0 0) (end 2.75 0)
    (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_circle (center 0 0) (end 3.05 0)
    (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_circle (center 0 0) (end 2.75 0)
    (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (pad "1" thru_hole circle (at -2.54 0) (size 1.6 1.6) (drill 0.9) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 2.54 0) (size 1.6 1.6) (drill 0.9) (layers "*.Cu" "*.Mask"))
