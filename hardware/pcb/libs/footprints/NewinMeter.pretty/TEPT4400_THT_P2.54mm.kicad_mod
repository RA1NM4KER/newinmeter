(footprint "TEPT4400_THT_P2.54mm"
  (version 20221018)
  (generator pcbnew)
  (layer "F.Cu")
  (descr "Vishay TEPT4400 ambient light phototransistor, T-1 (3mm) THT package. Dimensions per Vishay datasheet doc 81341 rev 1.8 (30-Jun-16), drawing 6.544-5054.01-4: body dia 3mm (housing 3.2mm), lead pitch 2.54mm nominal, lead dia 0.4-0.5mm. Pin assignment: datasheet package-dimensions top view shows leads left-to-right as E, C -- pad 1 (matches Device:Q_Photo_NPN pin 1 = Collector) placed on the RIGHT, pad 2 (Emitter) on the LEFT. DNP in PCB v1 -- populate only if bench-testing this sensor instead of the LDR. Verify polarity visually before hand-soldering.")
  (tags "phototransistor TEPT4400 ambient light")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -3.5) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "TEPT4400_THT_P2.54mm" (at 0 3.5) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_circle (center 0 0) (end 1.75 0)
    (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_circle (center 0 0) (end 2.05 0)
    (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_circle (center 0 0) (end 1.75 0)
    (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_text user "E" (at -1.27 -2.4) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (fp_text user "C" (at 1.27 -2.4) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (pad "2" thru_hole circle (at -1.27 0) (size 1.4 1.4) (drill 0.8) (layers "*.Cu" "*.Mask"))
  (pad "1" thru_hole rect (at 1.27 0) (size 1.4 1.4) (drill 0.8) (layers "*.Cu" "*.Mask"))
)
